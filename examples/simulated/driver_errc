# Problem name;

PROBLEM = "Demo error components";

@ Driver file for mixed logit or multinomial logit model calibration.

output "results_errc";

# number of individuals
np = 1000;
# number of observations
nobs = 5000;
# maximum number of alternatives represented in any choice situation
nalt = 5;

# number of variables (number of variables to estimate plus dependant
# variable - choice - plus atlernatives presences, if necessary,
# otherwise not added).
nvar = 6;

# number of variable that is the dependant variable (choice)
#iddep = 7;

# 1 if all people do not face nalt alternatives, else 0.
censor = 1;

# if censor: the number of the variable which identifies which
# alternatives each person faces.
idcensor = 6;

# maximum number of iterations in the maximization
niter = 150;

# tolerance for convergence
eps = 1e-5;

 bgentype = { CONSTANT, CONSTANT, CONSTANT, CONSTANT, ERRC };
 bgen = { 1, 1, 1, 1, 1 };
# type of parameters
 btype = { CONSTANT, CONSTANT, CONSTANT, CONSTANT, ERRC };
# starting values for the parameters
 b = { 0, 0, 0, 0, 0 };

# Random numbers generator
# seed for the random generator; if omitted or less or equal to 0, a
# random seed is created
seed1 = 26056320;


# draws set to 1 (or new) for new draws, 0 (or old) for previously
# generated draws. Default is draws = 1
#draws = new;
#draws = old;

#drawsname = "draws";

sampling = monte_carlo;
#sampling = halton;
#sampling = sobol;
#randomization = owen_faure_tezuka;
nrep = 1000;
#sampling = sobol;
#qmcrep = 1;
#scrambling = owen;
#scrambling = faure_tezuka;
#scrambling = owen_faure_tezuka;
#rangen = mt19937;
#rangen = parkmiller;
#rangen = ecuyer;
#sampling = uniform_vectors;

# be careful: MCBTRDA method is incompatible with varrep set to true!
varrep = false;

# indicate the observations source
# load allows to get observations from a file
# generate implies the generation of observations

###############################################################################
#
# DATA
#
###############################################################################

format = Train99;

#load "errc_data";
generate "errc_data";

alttypes[0] = { NORMAL, NORMAL, NORMAL,NORMAL,NORMAL,
		NORMAL, NORMAL, NORMAL, NORMAL, NORMAL};
altvalues[0] = { 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0,
		 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0};
alttypes[1] = { NORMAL, NORMAL,NORMAL, NORMAL,NORMAL,
		NORMAL, NORMAL, NORMAL, NORMAL, NORMAL};
altvalues[1] = { 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0,
		 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0};
alttypes[2] = { NORMAL, NORMAL, NORMAL, NORMAL, NORMAL,
		NORMAL, NORMAL, NORMAL, NORMAL, NORMAL};
altvalues[2] = { 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0,
		 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0};
alttypes[3] = { NORMAL, NORMAL,NORMAL,NORMAL, NORMAL,
		NORMAL, NORMAL, NORMAL, NORMAL, NORMAL};
altvalues[3] = { 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0,
		 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0};
alttypes[4] = { NORMAL, NORMAL,NORMAL,NORMAL,NORMAL,
		NORMAL, NORMAL, NORMAL, NORMAL, NORMAL};
altvalues[4] = { 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0,
		 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0};

# Specify the optimization algorithm

# Available methods are MCBTR (Basic Trust Region), MCBFGS,
# MCBTRDA (Basic Trust Region with Dynamic Accuracy)
METHOD = MCBTRDA;
#METHOD = MCBTR;
HESSIAN_UPDATE = bfgs;

# check the found solution
validation = false;

hessian_approx = true;
robust = true;

statistics = true;

bias=1;
